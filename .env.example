# Transport: "stdio" | "http" (default: http)
MCP_TRANSPORT=http

# HTTP listen address (default: 127.0.0.1)
MCP_HOST=127.0.0.1

# HTTP listen port (default: 8000)
MCP_PORT=8000

# HTTP path for the MCP endpoint (default: /mcp)
# MCP_PATH=/mcp

# Optional: require a Bearer token on HTTP requests (empty = no auth)
# MCP_AUTH_TOKEN=change-me
